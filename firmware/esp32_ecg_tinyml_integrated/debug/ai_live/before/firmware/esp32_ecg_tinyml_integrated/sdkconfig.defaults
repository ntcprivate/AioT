CONFIG_IDF_TARGET="esp32"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_ESP_TFLITE_MICRO_USE_ESP_NN=y
CONFIG_ECG_HARDWARE_SELF_TEST=y
CONFIG_ECG_TELEMETRY=y
# CONFIG_ECG_OPERATOR_TRACE is not set
CONFIG_ECG_TRACE_SAMPLE=5
# CONFIG_ECG_ENABLE_EXPERIMENTAL_LIVE is not set
# CONFIG_ECG_GOLDEN_ALERT_DEMO is not set
